<ContentDialog
    x:Class="TextFlow.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TextFlow.ViewModels"
    xmlns:infra="using:TextFlow.Infrastructure"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick">

    <Grid Width="520" Height="440">
        <TabView IsAddTabButtonVisible="False" TabWidthMode="SizeToContent">
            <!-- General Settings -->
            <TabViewItem Header="General" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE713;" />
                </TabViewItem.IconSource>
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Auto-Save Interval (seconds)" FontWeight="SemiBold" />
                            <NumberBox Value="{x:Bind ViewModel.AutoSaveIntervalSeconds, Mode=TwoWay}"
                                       SmallChange="5" LargeChange="10" Minimum="5" Maximum="600" SpinButtonPlacementMode="Inline" />
                            <TextBlock Text="Modified files are auto-saved in the background for crash protection."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Startup Behavior" FontWeight="SemiBold" />
                            <ComboBox SelectedValue="{x:Bind ViewModel.StartupBehavior, Mode=TwoWay}"
                                      SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Restore previous session files and tabs" Tag="RestoreSession" />
                                <ComboBoxItem Content="Open new blank document" Tag="BlankDocument" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Default Text Encoding" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableEncodings}"
                                      SelectedItem="{x:Bind ViewModel.DefaultEncoding, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Editor Settings -->
            <TabViewItem Header="Editor" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE70F;" />
                </TabViewItem.IconSource>
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Font Family" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFontFamilies}"
                                      SelectedItem="{x:Bind ViewModel.FontFamily, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Font Size" FontWeight="SemiBold" />
                                <NumberBox Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}"
                                           Minimum="8" Maximum="72" SmallChange="1" LargeChange="2" SpinButtonPlacementMode="Inline" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Font Style" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFontStyles}"
                                          SelectedItem="{x:Bind ViewModel.FontStyle, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <ToggleSwitch Header="Word Wrap"
                                      IsOn="{x:Bind ViewModel.WordWrap, Mode=TwoWay}" />

                        <ToggleSwitch Header="Show Line Numbers"
                                      IsOn="{x:Bind ViewModel.LineNumbers, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Theme Settings -->
            <TabViewItem Header="Theme" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE790;" />
                </TabViewItem.IconSource>
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="App Theme" FontWeight="SemiBold" />
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <RadioButton Content="Use system setting" />
                            <RadioButton Content="Light" />
                            <RadioButton Content="Dark" />
                        </RadioButtons>
                        <TextBlock Text="Change takes effect immediately with Fluent Design mica backdrop."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Google Drive Settings -->
            <TabViewItem Header="Google Drive" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE8B9;" />
                </TabViewItem.IconSource>
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Account Status" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.GoogleUserEmail, Mode=OneWay}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.ConnectButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ConnectGoogleDriveCommand}" />
                        </Grid>

                        <TextBox Header="Google OAuth Client ID"
                                 Text="{x:Bind ViewModel.GoogleClientId, Mode=TwoWay}"
                                 PlaceholderText="Enter Google Cloud Client ID..." />

                        <PasswordBox Header="Google OAuth Client Secret"
                                     Password="{x:Bind ViewModel.GoogleClientSecret, Mode=TwoWay}" />

                        <TextBox Header="Sync Folder Name"
                                 Text="{x:Bind ViewModel.GoogleSyncFolder, Mode=TwoWay}"
                                 PlaceholderText="e.g. TextFlowDocs" />

                        <ToggleSwitch Header="Enable Automatic Sync"
                                      IsOn="{x:Bind ViewModel.AutoSyncEnabled, Mode=TwoWay}" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Sync Interval (minutes)" FontWeight="SemiBold" />
                            <NumberBox Value="{x:Bind ViewModel.SyncIntervalMinutes, Mode=TwoWay}"
                                       Minimum="1" Maximum="120" SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- AI Extension Settings -->
            <TabViewItem Header="AI Extension" IsClosable="False">
                <TabViewItem.IconSource>
                    <FontIconSource Glyph="&#xE945;" />
                </TabViewItem.IconSource>
                <ScrollViewer Margin="0,12,0,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="AI Architecture &amp; Extension" FontWeight="SemiBold" />
                        <TextBlock Text="Configure AI plugins to summarize documents and explain SQL."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />

                        <PasswordBox Header="API Key (OpenAI / Compatible)"
                                     Password="{x:Bind ViewModel.AiApiKey, Mode=TwoWay}" />

                        <TextBox Header="Model Name"
                                 Text="{x:Bind ViewModel.AiModel, Mode=TwoWay}"
                                 PlaceholderText="e.g. gpt-4o, gpt-4o-mini" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</ContentDialog>
