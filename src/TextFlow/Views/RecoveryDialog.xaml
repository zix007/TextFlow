<ContentDialog
    x:Class="TextFlow.Views.RecoveryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TextFlow.ViewModels"
    xmlns:models="using:TextFlow.Models"
    mc:Ignorable="d"
    Title="Document Recovery"
    PrimaryButtonText="Restore All"
    SecondaryButtonText="Discard All"
    CloseButtonText="Close"
    PrimaryButtonClick="OnRestoreAllClick"
    SecondaryButtonClick="OnDiscardAllClick">

    <Grid Width="500" Height="340" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="TextFlow detected unsaved documents from a previous unexpected session. You can restore your work or discard the backups."
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.RecoverableFiles}"
                  SelectedItem="{x:Bind ViewModel.SelectedRecord, Mode=TwoWay}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AutoSaveRecord">
                    <Grid Padding="6,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Title, Mode=OneTime}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind OriginalFilePath, Mode=OneTime}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind FormattedSavedAt, Mode=OneTime}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Restore Selected"
                    Command="{x:Bind ViewModel.RestoreSelectedCommand}" />
            <Button Content="Discard Selected"
                    Command="{x:Bind ViewModel.DiscardSelectedCommand}" />
        </StackPanel>
    </Grid>
</ContentDialog>
